{
  "name": "treasury-alm-risk-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Treasury, ALM & Risk platform — system of record for a bank's treasury and balance sheet analytics",
  "workspaces": [
    "packages/*"
  ],
